# Production web image: build once, serve the static files with nginx (~10 MB of memory instead
# of the Vite dev server's ~180 MB). Development keeps using web/Dockerfile.
#   docker build -f web/Dockerfile.prod -t chakula-web web
FROM node:22-alpine AS build
WORKDIR /app
COPY package*.json ./
RUN npm ci
COPY . .
# Map tiles key (MapTiler). Baked into the web files at build time; blank = free OpenStreetMap tiles.
ARG VITE_MAPTILER_KEY=
ENV VITE_MAPTILER_KEY=$VITE_MAPTILER_KEY
RUN npm run build

FROM nginx:1.27-alpine
COPY nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html
EXPOSE 80
