# Copy this file to  .env  in the project folder on the SERVER and fill in every value marked
# CHANGE. Never commit .env and never copy it to a phone or into the web app.
#
# Make each secret with:   openssl rand -hex 32

# The public address (no https://, no slash).
DOMAIN=orderfood.co.ke
# Let's Encrypt writes here when a certificate is about to expire.
ACME_EMAIL=CHANGE@your-email.example

# Database. Use letters and numbers only (openssl rand -hex 24) so it fits inside a URL.
POSTGRES_USER=hotel
POSTGRES_PASSWORD=CHANGE
POSTGRES_DB=hotel

# Signs logins and Till-phone messages. Long and random, different from each other, never reused.
JWT_SECRET=CHANGE
FORWARDER_KEY=CHANGE

# Web Push alarms when a browser is closed. Make the keys on the server after the first start:
#   docker compose -f docker-compose.prod.yml exec api python -m app.cli vapid-keys
VAPID_PRIVATE_KEY=
VAPID_PUBLIC_KEY=
VAPID_SUBJECT=mailto:admin@orderfood.co.ke

# Road routing. Empty = the free public server (fine for the pilot). Your own server later:
#   OSRM_URL=http://osrm:5000/route/v1/driving
OSRM_URL=

# Backups (deploy/backup.sh). Leave empty to keep them only on this server. To also copy them to
# another place, set up rclone and name the destination, e.g. mydrive:chakula-backups
BACKUP_DIR=/var/backups/chakula
BACKUP_KEEP_DAYS=14
BACKUP_REMOTE=
