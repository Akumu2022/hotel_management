# Copy to .env and change for anything other than local development.
POSTGRES_USER=hotel
POSTGRES_PASSWORD=hotel
POSTGRES_DB=hotel
JWT_SECRET=change-me-to-a-long-random-string
FORWARDER_KEY=change-me-to-another-long-random-string
CORS_ORIGINS=http://localhost:5173
# Production (D29): the server refuses to start with APP_ENV=production unless JWT_SECRET and
# FORWARDER_KEY are long random values (32+ characters, e.g. `openssl rand -hex 32`) and the
# login cookie is HTTPS-only. Keep these values on the server only, never in the web app.
APP_ENV=development
COOKIE_SECURE=false
