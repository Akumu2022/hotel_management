# Copy to .env and change for anything other than local development.
POSTGRES_USER=hotel
POSTGRES_PASSWORD=hotel
POSTGRES_DB=hotel
JWT_SECRET=change-me-to-a-long-random-string
FORWARDER_KEY=change-me-to-another-long-random-string
CORS_ORIGINS=http://localhost:5173
# Production (D29): the server refuses to start with APP_ENV=production unless JWT_SECRET and
# FORWARDER_KEY are long random values (32+ characters, e.g. `openssl rand -hex 32`) and the
# login cookie is HTTPS-only. Keep these values on the server only, never in the web app.
APP_ENV=development
COOKIE_SECURE=false

# Optional extras (see README, "Deployment"). Empty = off / defaults.
# Web Push keys: docker compose exec api python -m app.cli vapid-keys
VAPID_PRIVATE_KEY=
VAPID_PUBLIC_KEY=
VAPID_SUBJECT=mailto:you@your-domain.example
# Shared rate limits for several API processes, e.g. redis://redis:6379/0
REDIS_URL=
# Your own routing server, e.g. http://osrm:5000/route/v1/driving (default: free public server)
OSRM_URL=
# true/false. Empty = on in development, off in production. Leave off in production: it can
# mark an order paid with no money.
PAYMENT_SIMULATOR=
# Password for `seed-demo` accounts (a random one is printed if empty). Never used in production.
DEMO_PASSWORD=
