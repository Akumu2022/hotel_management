<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Rider app only: keep sharing the location with a notification while the phone is locked or
         another app is in front. A foreground service needs no "always" location permission. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION"/>
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <uses-permission android:name="android.permission.WAKE_LOCK"/>
    <!-- Android 11+: let the app find the phone's camera app to take ID and selfie photos. -->
    <queries>
        <intent>
            <action android:name="android.media.action.IMAGE_CAPTURE"/>
        </intent>
    </queries>
</manifest>
